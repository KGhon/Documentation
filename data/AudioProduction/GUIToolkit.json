{
  "Example": "<pre style=\"margin: 0; padding: 20px; tab-size: 4; white-space: pre-wrap; word-break: break-word;\" class=\"shiki dark-plus\" style=\"background-color:#1E1E1E;color:#D4D4D4\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A9955\">--Store the GUIToolkit.lua file in the same location as the script that requires it. These lines load the GUIToolkit for use in this script.</span></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">ignore</span><span style=\"color:#D4D4D4\">, </span><span style=\"color: #9CDCFE\">filename</span><span style=\"color:#D4D4D4\"> = </span><span style=\"color:#9CDCFE\">reaper</span><span style=\"color:#D4D4D4\">.</span><span style=\"color:#DCDCAA\">get_action_context</span><span style=\"color:#D4D4D4\">()</span></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">directory</span><span style=\"color:#D4D4D4\"> = </span><span style=\"color: #9CDCFE\">filename</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">match</span><span style=\"color:#D4D4D4\">(</span><span style=\"color:#CE9178\">'^.+'</span><span style=\"color:#D4D4D4\">..</span><span style=\"color:#569CD6\">package.config</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">sub</span><span style=\"color:#D4D4D4\">(</span><span style=\"color:#B5CEA8\">1</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">1</span><span style=\"color:#D4D4D4\">))</span></span>\n<span class=\"line\"><span style=\"color:#DCDCAA\">dofile</span><span style=\"color:#D4D4D4\">(</span><span style=\"color: #9CDCFE\">directory</span><span style=\"color:#D4D4D4\">..</span><span style=\"color:#CE9178\">\"GUIToolkit_Kevin.lua\"</span><span style=\"color:#D4D4D4\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#C586C0\">function</span><span style=\"color:#DCDCAA\"> SetDisplayedText</span><span style=\"color:#D4D4D4\">(</span><span style=\"color:#9CDCFE\">text</span><span style=\"color:#D4D4D4\">)</span></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">    displayText</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">SetText</span><span style=\"color:#D4D4D4\">(</span><span style=\"color:#9CDCFE\">text</span><span style=\"color:#D4D4D4\">)</span></span>\n<span class=\"line\"><span style=\"color:#C586C0\">end</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A9955\">--Instantiate a native window.</span></span>\n<span class=\"line\"><span style=\"color: #F78279\">gfx</span><span style=\"color:#D4D4D4\">.</span><span style=\"color:#DCDCAA\">init</span><span style=\"color:#D4D4D4\">(</span><span style=\"color:#CE9178\">\"MyGUI\"</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">400</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">300</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">0</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">100</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">100</span><span style=\"color:#D4D4D4\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A9955\">--Instantiate a GUIContext.</span></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">gui</span><span style=\"color:#D4D4D4\"> = </span><span style=\"color:#4EC9B0\">GUIContext</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">New</span><span style=\"color:#D4D4D4\">()</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A9955\">--Instantiating a new UI element.</span></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">scaleContainer</span><span style=\"color:#D4D4D4\"> = </span><span style=\"color:#4EC9B0\">ScaleContainer</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">New</span><span style=\"color:#D4D4D4\">(</span><span style=\"color:#CE9178\">\"scale\"</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">0</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">0</span><span style=\"color:#D4D4D4\">, </span><span style=\"color: #F78279\">gfx</span><span style=\"color:#D4D4D4\">.</span><span style=\"color: #F78279\">w</span><span style=\"color:#D4D4D4\">, </span><span style=\"color: #F78279\">gfx</span><span style=\"color:#D4D4D4\">.</span><span style=\"color: #F78279\">h</span><span style=\"color:#D4D4D4\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A9955\">--Configure desired settings on the UI element.</span></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">scaleContainer</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">SetContentPadding</span><span style=\"color:#D4D4D4\">(</span><span style=\"color:#B5CEA8\">30</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">30</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">30</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">30</span><span style=\"color:#D4D4D4\">)</span></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">scaleContainer</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">SetNormalColor</span><span style=\"color:#D4D4D4\">(</span><span style=\"color:#B5CEA8\">30</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">30</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">30</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">1</span><span style=\"color:#D4D4D4\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A9955\">--Set the root of the GUIContext instance.</span></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">gui</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">SetRoot</span><span style=\"color:#D4D4D4\">(</span><span style=\"color: #9CDCFE\">scaleContainer</span><span style=\"color:#D4D4D4\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">verticalContainer</span><span style=\"color:#D4D4D4\"> = </span><span style=\"color:#4EC9B0\">VerticalContainer</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">New</span><span style=\"color:#D4D4D4\">(</span><span style=\"color:#CE9178\">\"vertical\"</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">0</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">0</span><span style=\"color:#D4D4D4\">, </span><span style=\"color: #F78279\">gfx</span><span style=\"color:#D4D4D4\">.</span><span style=\"color: #F78279\">w</span><span style=\"color:#D4D4D4\">, </span><span style=\"color: #F78279\">gfx</span><span style=\"color:#D4D4D4\">.</span><span style=\"color: #F78279\">h</span><span style=\"color:#D4D4D4\">)</span></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">verticalContainer</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">SetNormalColor</span><span style=\"color:#D4D4D4\">(</span><span style=\"color:#B5CEA8\">50</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">50</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">50</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">1</span><span style=\"color:#D4D4D4\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A9955\">--Make the UI element a child of another UI element.</span></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">scaleContainer</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">AddChild</span><span style=\"color:#D4D4D4\">(</span><span style=\"color: #9CDCFE\">verticalContainer</span><span style=\"color:#D4D4D4\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">horizontalContainer</span><span style=\"color:#D4D4D4\"> = </span><span style=\"color:#4EC9B0\">HorizontalContainer</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">New</span><span style=\"color:#D4D4D4\">(</span><span style=\"color:#CE9178\">\"horizontal\"</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">0</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">0</span><span style=\"color:#D4D4D4\">, </span><span style=\"color: #F78279\">gfx</span><span style=\"color:#D4D4D4\">.</span><span style=\"color: #F78279\">w</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">120</span><span style=\"color:#D4D4D4\">)</span></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">verticalContainer</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">AddChild</span><span style=\"color:#D4D4D4\">(</span><span style=\"color: #9CDCFE\">horizontalContainer</span><span style=\"color:#D4D4D4\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">button1</span><span style=\"color:#D4D4D4\"> = </span><span style=\"color:#4EC9B0\">Button</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">New</span><span style=\"color:#D4D4D4\">(</span><span style=\"color:#CE9178\">\"button 1\"</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">0</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">0</span><span style=\"color:#D4D4D4\">, </span><span style=\"color: #F78279\">gfx</span><span style=\"color:#D4D4D4\">.</span><span style=\"color: #F78279\">w</span><span style=\"color:#D4D4D4\">, </span><span style=\"color: #F78279\">gfx</span><span style=\"color:#D4D4D4\">.</span><span style=\"color: #F78279\">h</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#569CD6\">false</span><span style=\"color:#D4D4D4\">)</span></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">button1</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">SetMargins</span><span style=\"color:#D4D4D4\">(</span><span style=\"color:#B5CEA8\">20</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">20</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">20</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">20</span><span style=\"color:#D4D4D4\">)</span></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">button1</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">SetBorders</span><span style=\"color:#D4D4D4\">(</span><span style=\"color:#B5CEA8\">10</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">10</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">10</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">10</span><span style=\"color:#D4D4D4\">)</span></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">button1</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">SetBorderColor</span><span style=\"color:#D4D4D4\">(</span><span style=\"color:#B5CEA8\">80</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">80</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">80</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">1</span><span style=\"color:#D4D4D4\">)</span></span>\n<span class=\"line\"><span style=\"color:#6A9955\">--Assign a function to be called when certain UI events occur on a UI element. This event doesn't pass any values, but if it did you could receive them here to be used locally within the function body. ie. function(value1, value2, ...)</span></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">button1</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">AssignOnClicked</span><span style=\"color:#D4D4D4\">(</span></span>\n<span class=\"line\"><span style=\"color:#C586C0\">    function</span><span style=\"color:#D4D4D4\">()</span></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">        displayText</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">SetText</span><span style=\"color:#D4D4D4\">(</span><span style=\"color:#CE9178\">\"Hello\"</span><span style=\"color:#D4D4D4\">)</span></span>\n<span class=\"line\"><span style=\"color:#C586C0\">    end</span></span>\n<span class=\"line\"><span style=\"color:#D4D4D4\">)</span></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">horizontalContainer</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">AddChild</span><span style=\"color:#D4D4D4\">(</span><span style=\"color: #9CDCFE\">button1</span><span style=\"color:#D4D4D4\">)</span></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">text1</span><span style=\"color:#D4D4D4\"> = </span><span style=\"color:#4EC9B0\">Text</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">New</span><span style=\"color:#D4D4D4\">(</span><span style=\"color:#CE9178\">\"text 1\"</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">0</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">0</span><span style=\"color:#D4D4D4\">, </span><span style=\"color: #F78279\">gfx</span><span style=\"color:#D4D4D4\">.</span><span style=\"color: #F78279\">w</span><span style=\"color:#D4D4D4\">, </span><span style=\"color: #F78279\">gfx</span><span style=\"color:#D4D4D4\">.</span><span style=\"color: #F78279\">h</span><span style=\"color:#D4D4D4\">)</span></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">text1</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">SetText</span><span style=\"color:#D4D4D4\">(</span><span style=\"color:#CE9178\">\"Hello\"</span><span style=\"color:#D4D4D4\">)</span></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">text1</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">SetFont</span><span style=\"color:#D4D4D4\">(</span><span style=\"color:#B5CEA8\">2</span><span style=\"color:#D4D4D4\">)</span></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">button1</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">AddChild</span><span style=\"color:#D4D4D4\">(</span><span style=\"color: #9CDCFE\">text1</span><span style=\"color:#D4D4D4\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A9955\">--Use Duplicate() to more efficiently instantiate similar UI elements.</span></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">button2</span><span style=\"color:#D4D4D4\"> = </span><span style=\"color: #9CDCFE\">button1</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">Duplicate</span><span style=\"color:#D4D4D4\">()</span></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">button2</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">AssignOnClicked</span><span style=\"color:#D4D4D4\">(</span></span>\n<span class=\"line\"><span style=\"color:#C586C0\">    function</span><span style=\"color:#D4D4D4\">()</span></span>\n<span class=\"line\"><span style=\"color:#DCDCAA\">        SetDisplayedText</span><span style=\"color:#D4D4D4\">(</span><span style=\"color: #9CDCFE\">text2</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">GetText</span><span style=\"color:#D4D4D4\">())</span></span>\n<span class=\"line\"><span style=\"color:#C586C0\">    end</span></span>\n<span class=\"line\"><span style=\"color:#D4D4D4\">)</span></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">horizontalContainer</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">AddChild</span><span style=\"color:#D4D4D4\">(</span><span style=\"color: #9CDCFE\">button2</span><span style=\"color:#D4D4D4\">)</span></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">text2</span><span style=\"color:#D4D4D4\"> = </span><span style=\"color:#4EC9B0\">Text</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">New</span><span style=\"color:#D4D4D4\">(</span><span style=\"color:#CE9178\">\"text 2\"</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">0</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">0</span><span style=\"color:#D4D4D4\">, </span><span style=\"color: #F78279\">gfx</span><span style=\"color:#D4D4D4\">.</span><span style=\"color: #F78279\">w</span><span style=\"color:#D4D4D4\">, </span><span style=\"color: #F78279\">gfx</span><span style=\"color:#D4D4D4\">.</span><span style=\"color: #F78279\">h</span><span style=\"color:#D4D4D4\">)</span></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">text2</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">SetText</span><span style=\"color:#D4D4D4\">(</span><span style=\"color:#CE9178\">\"World\"</span><span style=\"color:#D4D4D4\">)</span></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">button2</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">AddChild</span><span style=\"color:#D4D4D4\">(</span><span style=\"color: #9CDCFE\">text2</span><span style=\"color:#D4D4D4\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">displayText</span><span style=\"color:#D4D4D4\"> = </span><span style=\"color:#4EC9B0\">Text</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">New</span><span style=\"color:#D4D4D4\">(</span><span style=\"color:#CE9178\">\"display\"</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">0</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#B5CEA8\">0</span><span style=\"color:#D4D4D4\">, </span><span style=\"color: #F78279\">gfx</span><span style=\"color:#D4D4D4\">.</span><span style=\"color: #F78279\">w</span><span style=\"color:#D4D4D4\">, </span><span style=\"color: #F78279\">gfx</span><span style=\"color:#D4D4D4\">.</span><span style=\"color: #F78279\">h</span><span style=\"color:#D4D4D4\">)</span></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">displayText</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">SetText</span><span style=\"color:#D4D4D4\">(</span><span style=\"color:#CE9178\">\"Click a button\"</span><span style=\"color:#D4D4D4\">)</span></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">verticalContainer</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">AddChild</span><span style=\"color:#D4D4D4\">(</span><span style=\"color: #9CDCFE\">displayText</span><span style=\"color:#D4D4D4\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A9955\">--Start running the GUIContext after all setup is complete</span></span>\n<span class=\"line\"><span style=\"color: #9CDCFE\">gui</span><span style=\"color:#D4D4D4\">:</span><span style=\"color:#DCDCAA\">Init</span><span style=\"color:#D4D4D4\">()</span></span></code></pre>",
  "GUIContextFunctions": [
    [
      "<code style=\"white-space: pre-wrap; word-break: break-word;\"><span class=\"line\"><span style=\"color:#C586C0\">function</span><span style=\"color:#DCDCAA\"> New</span><span style=\"color:#D4D4D4\">()</span></span></code>",
      "Constructor"
    ],
    [
      "<code style=\"white-space: pre-wrap; word-break: break-word;\"><span class=\"line\"><span style=\"color:#C586C0\">function</span><span style=\"color:#DCDCAA\"> SetRoot</span><span style=\"color:#D4D4D4\">()</span></span></code>",
      "Set the root UI element. All UI elements should be a descendant of the root."
    ],
    [
      "<code style=\"white-space: pre-wrap; word-break: break-word;\"><span class=\"line\"><span style=\"color:#C586C0\">function</span><span style=\"color:#DCDCAA\"> Init</span><span style=\"color:#D4D4D4\">()</span></span></code>",
      "Call after all UI is setup."
    ]
  ],
  "UIBaseFunctions": [
    [
      "<code style=\"white-space: pre-wrap; word-break: break-word;\"><span class=\"line\"><span style=\"color:#C586C0\">function</span><span style=\"color:#DCDCAA\"> New</span><span style=\"color:#D4D4D4\">(</span><span style=\"color: #569CD6\">string</span><span style=\"color:#9CDCFE\"> id</span><span style=\"color:#D4D4D4\">, </span><span style=\"color: #569CD6\">int</span><span style=\"color:#9CDCFE\"> posX</span><span style=\"color:#D4D4D4\">, </span><span style=\"color: #569CD6\">int</span><span style=\"color:#9CDCFE\"> posY</span><span style=\"color:#D4D4D4\">, </span><span style=\"color: #569CD6\">int</span><span style=\"color:#9CDCFE\"> width</span><span style=\"color:#D4D4D4\">, </span><span style=\"color: #569CD6\">int</span><span style=\"color:#9CDCFE\"> height</span><span style=\"color:#D4D4D4\">)</span></span></code>",
      "Constructor"
    ],
    [
      "<code style=\"white-space: pre-wrap; word-break: break-word;\"><span class=\"line\"><span style=\"color:#C586C0\">function</span><span style=\"color:#DCDCAA\"> Duplicate</span><span style=\"color:#D4D4D4\">(</span><span style=\"color: #569CD6\">string</span><span style=\"color:#9CDCFE\"> newID</span><span style=\"color:#D4D4D4\">)</span></span></code>",
