    [
      "<code style=\"white-space: pre-wrap; word-break: break-word;\"><span class=\"line\"><span style=\"color:#569CD6\">void</span><span style=\"color:#DCDCAA\"> ExecuteAudioEvent</span><span style=\"color:#D4D4D4\">(</span><span style=\"color:#4EC9B0\">UObject</span><span style=\"color:#D4D4D4\">* </span><span style=\"color:#9CDCFE\">WorldContext</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#4EC9B0\">AActor</span><span style=\"color:#D4D4D4\">*, </span><span style=\"color:#4EC9B0\">UAudioEvent</span><span style=\"color:#D4D4D4\">* </span><span style=\"color:#9CDCFE\">event</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#4EC9B0\">FVector</span><span style=\"color:#9CDCFE\"> location</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#4EC9B0\">FRotator</span><span style=\"color:#9CDCFE\"> rotation</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#569CD6\">bool</span><span style=\"color:#9CDCFE\"> attach</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#4EC9B0\">USceneComponent</span><span style=\"color:#D4D4D4\">* </span><span style=\"color:#9CDCFE\">attachTarget</span><span style=\"color:#D4D4D4\">)</span></span></code>",
      "BlueprintCallable\r\nExecutes all <a href='/Documentation/Pages/UnrealEngine/#AudioEventCommand'>AudioEventCommands</a> on the input <a href='/Documentation/Pages/UnrealEngine/#AudioEvent'>AudioEvent</a>. Sound commands use the request functions and therefore follow the same constraints."
    ],
