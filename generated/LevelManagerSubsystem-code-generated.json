      "<code style=\"white-space: pre-wrap; word-break: break-word;\"><span class=\"line\"><span style=\"color:#569CD6\">void</span><span style=\"color:#DCDCAA\"> UnloadLevel</span><span style=\"color:#D4D4D4\">(</span><span style=\"color:#4EC9B0\">TSoftObjectPtr</span><span style=\"color:#D4D4D4\">&#x3C;</span><span style=\"color:#4EC9B0\">UWorld</span><span style=\"color:#D4D4D4\">> </span><span style=\"color:#9CDCFE\">level</span><span style=\"color:#D4D4D4\">)</span></span></code>",
