      "<code style=\"white-space: pre-wrap; word-break: break-word;\"><span class=\"line\"><span style=\"color:#569CD6\">void</span><span style=\"color:#DCDCAA\"> CustomTriggerAllSoundsForActor</span><span style=\"color:#D4D4D4\">(</span><span style=\"color:#4EC9B0\">UObject</span><span style=\"color:#D4D4D4\">* </span><span style=\"color:#9CDCFE\">WorldContext</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#4EC9B0\">AActor</span><span style=\"color:#D4D4D4\">* </span><span style=\"color:#9CDCFE\">actor</span><span style=\"color:#D4D4D4\">, </span><span style=\"color:#569CD6\">const</span><span style=\"color:#4EC9B0\"> FName</span><span style=\"color:#D4D4D4\">&#x26; </span><span style=\"color:#9CDCFE\">name</span><span style=\"color:#D4D4D4\">)</span></span></code>",
